    "nodes": [
      {
        "id": "1e7469be-33f6-4e4d-a553-12bf12e9901c",
        "name": "Open shop checkout",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 2.1,
        "position": [
          0,
          0
        ],
        "parameters": {
          "httpMethod": "GET",
          "path": "shop",
          "responseMode": "responseNode",
          "options": {}
        },
        "webhookId": "8fb8911f-6923-4185-9a09-3d64d9173e5b"
