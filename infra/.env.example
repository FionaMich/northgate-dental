# Copy to infra/.env (git-ignored) and fill in. Readable only by the deploy user on the VM (chmod 600).
# Free wildcard DNS: sslip.io maps <anything>.84-12-126-31.sslip.io to 84.12.126.31 (the load balancer), no account needed (ADR 0008).
DOMAIN=84-12-126-31.sslip.io
SUBDOMAINS="n8n agent status"
# On after the detection-only trial; nothing sits behind the WAF yet, so it starts On.
MODSEC_RULE_ENGINE=On

# Local testing on a laptop without root: HTTP_PORT=18080 HTTPS_PORT=18443 DOMAIN=localhost
HTTP_PORT=80
HTTPS_PORT=443

# Nightly backups (scripts/backup.sh). The database URL is the production session pooler URL from the Supabase dashboard.
SUPABASE_DB_URL=
BACKUP_AGE_PUBLIC_KEY=
BACKUP_BUCKET=
AWS_REGION=eu-north-1
# Upload-only IAM user: s3:PutObject on the bucket's nightly/ prefix and nothing else.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Notification worker (section 07). Login created by hand on the project: role northgate_worker_app in northgate_worker.
WORKER_DB_URL=
RESEND_API_KEY=
EMAIL_FROM="Northgate Dental <onboarding@resend.dev>"
EMAIL_REDIRECT_TO=
# The clinic inbox that receives urgent post-visit check-in alerts (IDs only).
CLINIC_ALERT_EMAIL=

# n8n on the VM (profile n8n). Fill both with the output of: openssl rand -hex 32
# Keep a copy of the encryption value off the VM: n8n's stored credentials cannot be decrypted without it,
# and it is deliberately left out of the backups.
N8N_DB_PASSWORD=
# encryption value for stored credentials
N8N_ENCRYPTION_KEY=

# LangSmith tracing for the assistant (inputs and outputs hidden; nodes, tools, timings and outcomes only).
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://aws.api.smith.langchain.com
LANGSMITH_PROJECT=northgate-assistant
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true

# The receptionist assistant (section 10): the Supabase project the app signs in to, and its publishable key
# (grants nothing without a patient's token).
ASSISTANT_SUPABASE_URL=
ASSISTANT_SUPABASE_KEY=
