# Copy to infra/.env (git-ignored) and fill in. Readable only by the deploy user on the VM (chmod 600).
# Free wildcard DNS: sslip.io maps <anything>.84-12-126-31.sslip.io to 84.12.126.31 (the load balancer), no account needed (ADR 0008).
DOMAIN=84-12-126-31.sslip.io
SUBDOMAINS="n8n agent status"
# On after the detection-only trial; nothing sits behind the WAF yet, so it starts On.
MODSEC_RULE_ENGINE=On

# Local testing on a laptop without root: HTTP_PORT=18080 HTTPS_PORT=18443 DOMAIN=localhost
HTTP_PORT=80
HTTPS_PORT=443

# Nightly backups (scripts/backup.sh). The database URL is the production session pooler URL from the Supabase dashboard.
SUPABASE_DB_URL=
BACKUP_AGE_PUBLIC_KEY=
BACKUP_BUCKET=
AWS_REGION=eu-north-1
# Upload-only IAM user: s3:PutObject on the bucket's nightly/ prefix and nothing else.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
