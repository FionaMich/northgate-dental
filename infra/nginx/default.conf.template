# Northgate's front door. Replaces the image's default server; the image still loads ModSecurity with the
# OWASP Core Rule Set for every server below (conf.d/modsecurity.conf). ${DOMAIN} comes from infra/.env.

server_tokens off;
more_clear_headers Server;

# Per client address; the login, booking and agent endpoints of later sections use the strict zone.
limit_req_zone $binary_remote_addr zone=general:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=strict:10m rate=5r/s;
limit_req_status 429;
# Rate-limit events would log the full request line, query string included: keep them below the log level (warn).
limit_req_log_level info;

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# Plain HTTP: only Let's Encrypt's challenge files; everything else moves to HTTPS.
server {
    listen 8080 default_server;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 8443 ssl default_server;
    http2 on;
    server_name ${DOMAIN} *.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/northgate/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/northgate/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Content-Security-Policy "default-src 'none'; style-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'" always;

    client_max_body_size 5m;
    limit_req zone=general burst=40 nodelay;

    # Static files, not "return": return answers before ModSecurity and limit_req run, so it would skip the WAF.
    root /usr/share/nginx/static;

    location = /health {
        default_type text/plain;
        try_files /health =404;
    }

    # The root page says what this address is; services join on their own subdomains (n8n in 07, the agent in 10).
    location = / {
        try_files /index.html =404;
    }
    location = /style.css {
        try_files /style.css =404;
    }
    location / {
        try_files /nonexistent =404;
    }

    # One branded page for every error, so no response names the server software.
    error_page 400 403 404 405 413 429 500 502 503 504 /error.html;
    location = /error.html {
        internal;
        try_files /error.html =404;
    }
}

# n8n: only webhooks are public (Stripe, Meta); the editor and API answer 404 here and are reached through the Bastion.
server {
    listen 8443 ssl;
    http2 on;
    server_name n8n.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/northgate/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/northgate/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    root /usr/share/nginx/static;
    error_page 400 403 404 405 413 429 500 502 503 504 /error.html;
    location = /error.html {
        internal;
        try_files /error.html =404;
    }

    client_max_body_size 1m;

    location /webhook/ {
        limit_req zone=strict burst=20 nodelay;
        resolver 127.0.0.11 valid=30s;  # Docker's DNS, so Nginx starts even when n8n is not running
        set $n8n http://n8n:5678;
        proxy_pass $n8n;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        try_files /nonexistent =404;
    }
}
