# Northgate's front door. Replaces the image's default server; the image still loads ModSecurity with the
# OWASP Core Rule Set for every server below (conf.d/modsecurity.conf). ${DOMAIN} comes from infra/.env.

server_tokens off;
more_clear_headers Server;

# Per client address; the login, booking and agent endpoints of later sections use the strict zone.
limit_req_zone $binary_remote_addr zone=general:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=strict:10m rate=5r/s;
limit_req_status 429;

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# Plain HTTP: only Let's Encrypt's challenge files; everything else moves to HTTPS.
server {
    listen 8080 default_server;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 8443 ssl default_server;
    http2 on;
    server_name ${DOMAIN} *.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/northgate/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/northgate/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'" always;

    client_max_body_size 5m;
    limit_req zone=general burst=40 nodelay;

    # Static files, not "return": return answers before ModSecurity and limit_req run, so it would skip the WAF.
    root /usr/share/nginx/static;

    location = /health {
        default_type text/plain;
        try_files /health =404;
    }

    # Services join here in later sections (n8n in 07, the agent in 10), each on its own subdomain.
    location / {
        try_files /nonexistent =404;
    }
}
