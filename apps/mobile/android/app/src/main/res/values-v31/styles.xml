<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: brand teal and the tooth instead of the default white screen. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/brand_deep</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_tooth</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/brand_deep</item>
    </style>
</resources>
